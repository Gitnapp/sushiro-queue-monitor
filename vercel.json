{
  "rewrites": [
    { "source": "/", "destination": "/public/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=30, s-maxage=60" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "*/3 * * * *"
    }
  ]
}
